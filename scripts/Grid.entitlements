<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: lets GRID send Apple Events (the Now Playing widget's controls; shells
	     inherit GRID's TCC identity for osascript too). macOS still asks the user per target app. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The Map's Locate button (CoreLocation, when in use). macOS still asks the user. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
